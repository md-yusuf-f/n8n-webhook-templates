# Telegram bot configuration
# Get bot token from @BotFather: https://t.me/BotFather
# Get chat ID from @userinfobot: https://t.me/userinfobot

TELEGRAM_BOT_TOKEN=123456789:AAA-your-bot-token-here
TELEGRAM_CHAT_ID=000000000

# Email configuration (workflow 02 — Contact Form)
# SMTP credentials (host, port, user, pass) are set in n8n UI: Settings → Credentials → New → SMTP
ADMIN_EMAIL=you@example.com
SMTP_FROM_EMAIL=noreply@example.com

# Optional — if you want to use a webhook secret to verify incoming requests
WEBHOOK_SECRET=change-this-to-a-random-string
